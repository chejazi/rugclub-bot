# Express tip bot + address resolve cache
PORT=8787

# Chain
BASE_RPC_URL=
PROTOCOL_ADDRESS=
TIP_DISTRIBUTOR_ADDRESS=
TIP_OPERATOR_KEY=

# Neynar
NEYNAR_API_KEY=
NEYNAR_WEBHOOK_SECRET=
NEYNAR_SIGNER_UUID=
# Existing webhook id to update (create once in dashboard or via API)
NEYNAR_WEBHOOK_ID=
# Public URL Neynar should POST to, e.g. https://bot.example.com/webhook/neynar
NEYNAR_WEBHOOK_TARGET_URL=

# DEV | PROD — labels the Neynar webhook (rugclub-tips-DEV / rugclub-tips-PROD)
TIP_BOT_ENV=DEV

# Shared secret for Track Debug replay (and optional app resolve proxy)
TIP_BOT_REPLAY_SECRET=

# Comma/space-separated addresses excluded from tip weight (e.g. your own wallet)
TIP_EXCLUDE_ADDRESSES=

# File-backed state
QUEUE_PATH=./data/queue.json
RESOLVE_CACHE_PATH=./data/resolve-cache.json

# Worker
TIP_INTERVAL_MS=30000
